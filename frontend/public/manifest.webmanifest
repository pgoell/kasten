{
  "id": "/",
  "name": "kasten",
  "short_name": "kasten",
  "description": "A markdown notebook, and a box for today's dump.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#282c34",
  "theme_color": "#282c34",
  "icons": [
    { "src": "/icons/app-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/app-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    {
      "src": "/icons/app-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Capture",
      "description": "Put a thought into today's dump.",
      "url": "/capture",
      "icons": [{ "src": "/icons/capture-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "share_target": {
    "action": "/capture",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  }
}
