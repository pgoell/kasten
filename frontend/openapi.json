{
  "openapi": "3.1.0",
  "info": {
    "title": "kasten",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health",
        "description": "Report that the process is up. Deliberately does not touch the database.",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/files": {
      "get": {
        "summary": "List Files",
        "description": "List every note in the vault as a relative POSIX path, sorted.\n\nThe client folds these into a folder tree; the server stays flat.",
        "operationId": "list_files_api_files_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array",
                  "title": "Response List Files Api Files Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/search": {
      "get": {
        "summary": "Search Files",
        "description": "Find every line in the vault containing `q`, ignoring case.\n\nA literal match, not a regex and not a fuzzy one. The client ranks what\ncomes back, which is what makes the finder feel fuzzy without asking a\nsubsequence match to mean something over prose, where it matches everything.",
        "operationId": "search_files_api_search_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Q"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SearchHit"
                  },
                  "title": "Response Search Files Api Search Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/files/{path}": {
      "get": {
        "summary": "Read File",
        "description": "Read one note out of the vault.\n\nAnything that is not a readable markdown file inside the vault is a 404,\nincluding paths that try to climb out of it.",
        "operationId": "read_file_api_files__path__get",
        "parameters": [
          {
            "name": "path",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Path"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Note"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create File",
        "description": "Start a new, empty note in the vault.\n\nThis one says why it refused, unlike the read and the write: a 409 for a\npath already taken and a 400 for one the vault will not have. The user is\nabout to retype the path and has to know which it was, and the one user\nbehind oauth2-proxy learns nothing from a 409 that `GET /api/files` did not\nalready hand them.\n\nThe path that comes back is the canonical spelling, not the URL's, because\nthe client navigates to it and `ideas/./kasten.md` must not end up in the\naddress bar.\n\nThe new note gets its own jj change, bracketed the way a save is. Both\nrefusals return before any of that, so a bounced create leaves no change\nbehind.",
        "operationId": "create_file_api_files__path__post",
        "parameters": [
          {
            "name": "path",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Path"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Note"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Save File",
        "description": "Write one note back to the vault.\n\nOnly over a note that is already there. Everything the read refuses is\nrefused here too, and for the same reason, so a note you cannot open is a\nnote you cannot overwrite.\n\nThe jj change is started before the write and the snapshot taken after, so\nthe edit is bracketed by the history rather than trailing it. A vault that\nis not a jj repo skips both.",
        "operationId": "save_file_api_files__path__put",
        "parameters": [
          {
            "name": "path",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Path"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NoteEdit"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Note"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "patch": {
        "summary": "Move File",
        "description": "Give one note a new path, moving it between folders as well as renaming it.\n\n`PATCH` rather than a `/rename` route because the path is the note's\nidentity: `POST` starts a note, `PUT` replaces its text, and this changes\nwhere it lives. A verb in the URL would be the same thing spelled as a\nremote procedure call.\n\nA missing source is a 404, matching the read and the write, so a note you\ncannot open stays a note you cannot move. The target names its refusal the\nway a create does, a 400 for a path the vault will not have and a 409 for\none already taken, because the user is about to retype it and has to know\nwhich it was.\n\nThe text comes back read off disk rather than carried over from the client.\nBoth the URL and the query key change on a move, and seeding the new one\nfrom here is what stops a note edited outside kasten arriving stale on the\nother side.",
        "operationId": "move_file_api_files__path__patch",
        "parameters": [
          {
            "name": "path",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Path"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NoteMove"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Note"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/folders/{path}": {
      "patch": {
        "summary": "Move Folder",
        "description": "Give one folder a new path, and every note under it a new path with it.\n\nIts own route rather than the one above, because a folder is not a note and\n`/api/files/inbox` cannot mean the folder on a `PATCH` and nothing at all on\na `GET`. What the two share is the shape: the URL says where it lives now,\nthe body where it should live from here on.\n\nThe refusals are the note's, read for a folder. A source that is not a\nfolder is a 404, a note at that path included, so the one way to move a note\nstays the route above. The target names its refusal, a 400 for a path the\nvault will not have and a 409 for one already taken, because the user is\nabout to retype it.\n\nA target inside the source is a 400 too. A folder cannot hold itself, and\n`rename` raises on that rather than refusing, so it is caught here with the\nrest.\n\nNo content comes back. The notes under the folder are at new paths now, but\nthey are unchanged, and the client works out where they went from the folder\npath alone.",
        "operationId": "move_folder_api_folders__path__patch",
        "parameters": [
          {
            "name": "path",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Path"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FolderMove"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Folder"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Folder": {
        "properties": {
          "path": {
            "type": "string",
            "title": "Path"
          }
        },
        "type": "object",
        "required": [
          "path"
        ],
        "title": "Folder",
        "description": "One folder, as the vault spells it.\n\nNo content beside the path. A folder is the prefix of the notes under it and\nholds nothing of its own, so there is nothing else to answer with."
      },
      "FolderMove": {
        "properties": {
          "path": {
            "type": "string",
            "title": "Path"
          }
        },
        "type": "object",
        "required": [
          "path"
        ],
        "title": "FolderMove",
        "description": "Where a folder should live from now on, and every note under it with it."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "Health",
        "description": "Liveness response."
      },
      "Note": {
        "properties": {
          "path": {
            "type": "string",
            "title": "Path"
          },
          "content": {
            "type": "string",
            "title": "Content"
          }
        },
        "type": "object",
        "required": [
          "path",
          "content"
        ],
        "title": "Note",
        "description": "One note, as it sits on disk."
      },
      "NoteEdit": {
        "properties": {
          "content": {
            "type": "string",
            "title": "Content"
          }
        },
        "type": "object",
        "required": [
          "content"
        ],
        "title": "NoteEdit",
        "description": "The new text for a note. The path it belongs to comes from the URL."
      },
      "NoteMove": {
        "properties": {
          "path": {
            "type": "string",
            "title": "Path"
          }
        },
        "type": "object",
        "required": [
          "path"
        ],
        "title": "NoteMove",
        "description": "Where a note should live from now on. Where it lives today comes from the URL."
      },
      "SearchHit": {
        "properties": {
          "path": {
            "type": "string",
            "title": "Path"
          },
          "line": {
            "type": "integer",
            "title": "Line"
          },
          "text": {
            "type": "string",
            "title": "Text"
          }
        },
        "type": "object",
        "required": [
          "path",
          "line",
          "text"
        ],
        "title": "SearchHit",
        "description": "One line in the vault that matched, and enough to open the note on it."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
