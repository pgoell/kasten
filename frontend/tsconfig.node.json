{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "composite": true,
    "emitDeclarationOnly": true,
    // vite.config.ts imports src/lib/csp.ts by its real name, which is what
    // Vite's native config loader wants and what keeps it from warning.
    "allowImportingTsExtensions": true,
    "declaration": true,
    "outDir": "./.tsbuildinfo-node",
    "allowSyntheticDefaultImports": true
  },
  "include": ["vite.config.ts"]
}
