{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!dist",
      "!node_modules",
      "!public/pdfjs",
      "!src/routeTree.gen.ts",
      "!src/lib/api-types.ts",
      "!openapi.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "useExhaustiveDependencies": "error",
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        // It reads a key map's `Enter: () => ...` as a component, and a test's
        // harness component inside its test is on purpose.
        "noComponentHookFactories": "off"
      },
      // `innerText` keeps the line breaks layout puts in, which the e2e
      // scripts read the editor for; `textContent` runs the lines together.
      "performance": {
        "useDomNodeTextContent": "off"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": { "maxAllowedComplexity": 15 }
        }
      },
      "style": {
        "noDefaultExport": "off",
        "useImportType": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "css": {
    "parser": {
      "cssModules": true,
      "tailwindDirectives": true
    },
    "formatter": { "enabled": false }
  },
  "overrides": [
    {
      "includes": ["**/*.css"],
      "linter": { "enabled": false }
    },
    // The last file over the cognitive-complexity limit from #939's list. pgoell
    // keeps it on (#968 gives no reason). Nothing goes on and the limit never
    // rises; backend/tests/test_complexity_baseline.py guards the count.
    {
      "includes": ["src/lib/notes/note/save-queue.ts"],
      "linter": {
        "rules": { "complexity": { "noExcessiveCognitiveComplexity": "off" } }
      }
    }
  ],
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
