{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!dist",
      "!node_modules",
      "!public/pdfjs",
      "!src/routeTree.gen.ts",
      "!src/lib/api-types.ts",
      "!openapi.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "useExhaustiveDependencies": "error",
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": { "maxAllowedComplexity": 15 }
        }
      },
      "style": {
        "noDefaultExport": "off",
        "useImportType": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "css": {
    "parser": {
      "cssModules": true,
      "tailwindDirectives": true
    },
    "formatter": { "enabled": false }
  },
  "overrides": [
    {
      "includes": ["**/*.css"],
      "linter": { "enabled": false }
    },
    // The files over the cognitive-complexity limit when the rule came in (#939).
    // This list may only shrink: a file comes off when it passes, never by
    // raising the limit, and nothing goes on. The shell/chat paths are relative
    // to the repo root, where `shell:lint` runs. The count is guarded by
    // backend/tests/test_complexity_baseline.py.
    {
      "includes": [
        "src/components/note-pane.tsx",
        "src/lib/note/held-buffer.ts",
        "src/lib/held-text.ts",
        "src/lib/note/save-queue.ts",
        "src/lib/note/use-buffer-sync.ts",
        "src/lib/note/use-buffer-write.ts",
        "src/lib/use-guarded-writes.ts",
        "src/lib/note/use-note-opening.ts",
        "src/lib/note/vault-reads.ts",
        "src/lib/note/write-answer.ts",
        "shell/chat/runner.mjs",
        "shell/chat/runner.test.mjs",
        "shell/chat/stub.mjs"
      ],
      "linter": {
        "rules": { "complexity": { "noExcessiveCognitiveComplexity": "off" } }
      }
    }
  ],
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
