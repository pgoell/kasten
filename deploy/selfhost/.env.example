# deploy/selfhost/.env.example
#
# Copy to `.env` beside compose.yaml and fill in. docker compose reads `.env`
# on its own. docs/how-to/self-host-kasten.md walks through every step.

# --- Required ---------------------------------------------------------------

# The name the notebook is served at. Caddy gets its certificate for this name,
# and the backend answers agents on it. For the tailscale gate, this machine's
# MagicDNS name, such as `kasten.tail1234.ts.net`.
KASTEN_DOMAIN=kasten.example.com

# Which login sits in front of the notebook: basicauth, oauth2-proxy or
# tailscale. There is no default, and compose refuses to start without one.
KASTEN_GATE=basicauth

# --- Gate: basicauth ---------------------------------------------------------

# The user name the browser asks for, and its bcrypt hash from
#   docker run --rm -it caddy:2.11.4-alpine caddy hash-password
# Keep the single quotes: the hash is full of `$`, which compose would
# otherwise read as variables.
KASTEN_BASIC_AUTH_USER=
KASTEN_BASIC_AUTH_HASH=''

# --- Gate: oauth2-proxy ------------------------------------------------------

# Starts the oauth2-proxy service. Leave it commented for the other gates.
#COMPOSE_PROFILES=oauth2-proxy

# `github`, or `oidc` for any OpenID Connect provider (then set the issuer).
OAUTH2_PROXY_PROVIDER=github
OAUTH2_PROXY_OIDC_ISSUER_URL=
# From the OAuth app you register with the provider. Its callback URL is
# https://<KASTEN_DOMAIN>/oauth2/callback.
OAUTH2_PROXY_CLIENT_ID=
OAUTH2_PROXY_CLIENT_SECRET=
# 32 random bytes: `openssl rand -base64 32 | tr -- '+/' '-_'`
OAUTH2_PROXY_COOKIE_SECRET=
# Who may sign in is `allowed-emails.txt` beside this file, one address a line.

# --- Gate: tailscale ---------------------------------------------------------

# Adds the tailscaled socket mount Caddy needs for a `*.ts.net` certificate.
#COMPOSE_FILE=compose.yaml:compose.tailscale.yaml
# Set KASTEN_BIND_ADDRESS below to this machine's address from `tailscale ip -4`.

# --- Optional ----------------------------------------------------------------

# Where the vault and the agent token store live on this machine. Relative
# paths resolve against this directory.
KASTEN_DATA_DIR=./data

# The uid and gid the backend and shell run as. Leave them at 1000: the shell
# image's user is 1000, and the shell fails to start as any other. Give
# KASTEN_DATA_DIR to them (`sudo chown -R 1000:1000 data`), or the containers
# cannot write notes.
KASTEN_UID=1000
KASTEN_GID=1000

# The address and ports Caddy listens on. 0.0.0.0 is every interface.
KASTEN_BIND_ADDRESS=0.0.0.0
KASTEN_HTTP_PORT=80
KASTEN_HTTPS_PORT=443

# Which images to run. A release number such as 0.30.0 pins one; `latest`
# follows every release.
KASTEN_IMAGE_REPO=ghcr.io/pgoell
KASTEN_IMAGE_TAG=latest

# Who a commit made in the shell is by. Seeded into the shell's jj and git
# config on start, only where nothing is set yet.
#JJ_USER=Your Name
#JJ_EMAIL=you@example.com
