# A username and a bcrypt hash, from `caddy hash-password`. The browser asks
# once and sends the pair with every request after, the event stream and the
# terminal's WebSocket included.
#
# A name with no hash is an error, and Caddy refuses the whole file rather
# than serve an open notebook. With both empty, which is what compose passes
# for a blank `.env` line, Caddy starts and refuses every login: closed, not
# open. The `unset` fallback covers a variable missing from the environment
# altogether, where an empty block would parse fine.

(site) {
}

(gate) {
	basic_auth {
		{$KASTEN_BASIC_AUTH_USER:unset} {$KASTEN_BASIC_AUTH_HASH}
	}
}
