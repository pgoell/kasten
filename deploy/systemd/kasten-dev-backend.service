[Unit]
Description=kasten dev backend (uvicorn --reload)
After=network-online.target docker.service

[Service]
Type=simple
WorkingDirectory=/home/pascal/Code/kasten

# Bind the `web` bridge gateway, not 0.0.0.0. Caddy runs in a container on that
# network and can reach this address; the public interface cannot. Re-derive it
# after any recreation of the network with:
#   docker network inspect web --format '{{(index .IPAM.Config 0).Gateway}}'
Environment=KASTEN_DEV_BIND=172.18.0.1

ExecStart=/home/pascal/.local/bin/mise x -- uv run uvicorn kasten_backend.main:app \
    --reload --host ${KASTEN_DEV_BIND} --port 8000

Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
