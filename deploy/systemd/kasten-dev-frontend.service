[Unit]
Description=kasten dev frontend (vite dev server)
After=network-online.target docker.service

[Service]
Type=simple
WorkingDirectory=/home/pascal/Code/kasten/frontend

# See the note in kasten-dev-backend.service about this address.
Environment=KASTEN_DEV_BIND=172.18.0.1
# Setting this switches vite into hosted mode: it accepts the public Host
# header and points the HMR websocket at wss://<host>:443 so hot reload keeps
# working through Caddy. Unset means plain localhost dev.
Environment=KASTEN_DEV_PUBLIC_HOST=kasten-dev.pascalkraus.com

ExecStart=/home/pascal/.local/bin/mise x -- pnpm dev

Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
