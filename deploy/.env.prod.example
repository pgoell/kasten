# Template for /home/pascal/kasten-deploy/.env.prod on the VPS.
# The real file never enters git. See deploy/README.md for the bootstrap.

# Password comes from the bootstrap step in deploy/README.md. The host is the
# shared `postgres` container on the web network, reached by name.
KASTEN_DATABASE_URL=postgresql+psycopg://kasten_prod:REPLACE_ME@postgres:5432/kasten_prod

# Where the vault is mounted inside the container. The host side of that mount
# is pinned in deploy/compose.yaml, not here, so a typo cannot silently point
# production at an empty directory.
KASTEN_VAULT_PATH=/vault

# Where an imported Anki deck is written. The default is `03 Flashcards`, which
# would sit beside `03 Areas` in this vault and share its number, so a deck
# lands in the inbox and gets filed by hand from there.
KASTEN_FLASHCARDS_PATH=00 Inbox

# Where the agent tokens are kept. The directory above it is what
# deploy/compose.yaml mounts, never this file: `os.replace` over a bind-mounted
# file fails with EBUSY and every mint would break.
KASTEN_TOKENS_PATH=/agent-data/tokens.json

# The Host the MCP endpoint answers to. The SDK's DNS-rebinding protection is
# left on and its own default allowlist is localhost only, which would answer
# 421 to everything arriving through Caddy.
KASTEN_AGENT_HOST=kasten.pascalkraus.com

# Nothing in this file is a secret but the database password above, and
# `kasten-migrate-prod` reads the same env_file. The two settings above are a
# path and a hostname by design: no token, no digest and no secret goes here.
