#!/bin/sh
# kasten's PostToolUse hook, by the name .claude/settings.json gives it. It runs
# this checkout's structure-hook, never the edited repo's copy, which may be code
# nobody has read (#1464). structure-hook passes a file whose repo has no copy at
# its path, such as the colocated jj repo in vault/.
exec "$(dirname "$0")/structure-hook"
