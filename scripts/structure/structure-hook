#!/bin/sh
# shellcheck shell=bash
# Canonical copy: plugins/structure/skills/setting-up-the-checks/assets/structure-hook
# in pgoell/pgoell-claude-tools. Every other copy stays byte-identical to it.
#
# Claude Code PostToolUse hook for Edit, Write and MultiEdit. Reads the hook
# JSON on stdin and runs check-file-size and check-fan-out, which sit beside
# this script, on tool_input.file_path. Exit 2 shows their message to Claude;
# exit 0 says nothing. A file outside a git repo, ignored by git, or in a repo
# with no copy of this hook at the same path (a nested repo the project ignores)
# passes. A symlinked scripts/ counts as scripts/. A file in another repo or
# worktree that has a copy meets that repo's baseline and excludes, through this
# copy's scripts. It runs no code from the repo of an edited file, which may be
# a clone nobody has read, unless a folder in that repo is on the user's own PATH:
# git asks that repo only where its top and its info/exclude are, and every other
# git runs against a throwaway git dir. So that repo's config, hooks, filters,
# fsmonitor and objects stay out of it, and so does its mise config.
#
# Nor does it hang on that repo, whose files may be FIFOs or symlinks to devices:
# the checks read their settings only from regular files and only so far, and a
# job kills everything after 30 s. Then the hook exits 1 with a message, which
# Claude Code reports without blocking.

# Starts as sh, since "env bash" could find a bash in the current folder. A PATH
# entry that does not start with "/" names a folder relative to where a tool runs,
# which here may be the edited repo. An empty PATH would mean the current folder.
# An absolute entry stays, even inside that repo: it is the user's own setting.
# Mise's shim folder goes, since a shim runs a path: tool that the mise config of
# the folder it runs in names, trusted or not.
rest=${PATH:-}:
clean=
data=$(cd "${MISE_DATA_DIR:-/nonexistent}" 2>/dev/null && pwd -P)
while [ -n "$rest" ]; do
  entry=${rest%%:*}
  rest=${rest#*:}
  case $entry in /*) ;; *) continue ;; esac
  case $(cd "$entry" 2>/dev/null && pwd -P) in
    */mise/shims | "${data:-/nonexistent}/shims") ;;
    *) clean=$clean:$entry ;;
  esac
done
PATH=${clean#:}
PATH=${PATH:-/usr/bin:/bin}
export PATH
# Bash as sh also sets BASH_VERSION, so the mark tells it from a plain bash.
if [ -z "${BASH_VERSION:-}" ] || [ -z "${STRUCTURE_HOOK_IN_BASH:-}" ]; then
  export STRUCTURE_HOOK_IN_BASH=1
  exec bash "$0"
fi
unset STRUCTURE_HOOK_IN_BASH
# With CDPATH, cd can land elsewhere and print the path it found.
unset CDPATH

set -uo pipefail

limit=30
# Dirname and $(...) would strip a newline that ends the folder's name.
case $0 in */*) dir=${0%/*}/ ;; *) dir=. ;; esac
dir=$(cd "$dir" && pwd && echo x)
dir=${dir%$'\n'x}
# With stdin closed, the job's fd 3 could not copy it, and a pipe could land on fd 0.
true 2>&- 3<&0 || exec </dev/null
# A terminal is a person, who ends the event with Ctrl-D, and a background job could
# not read from it.
input=
if [ -t 0 ]; then
  input=$(head -c 16777216)
  exec </dev/null
fi
scratch=$(mktemp -d) && scratch=$(cd "$scratch" && pwd) || exit 0

check() {
  # Stdin may stay open or never end, so this read is on the job's clock. An event
  # over this size fails in jq, below. Nothing else needs the event's stdin.
  input+=$(head -c 16777216 <&3)
  exec 3<&-
  # $(...) strips a newline that ends a name, so the name ends in a mark until then.
  filter='(.tool_input.file_path // empty) | tostring + "x"'
  # Mise reads no project's config here: from the hook's folder it would read the
  # edited repo's when the hook sits in that repo. Mise may be on PATH only as what
  # the shims link to.
  if command -v jq >/dev/null; then
    file=$(jq -r "$filter" <<<"$input")
  else
    mise=$(command -v mise) || mise=$(readlink -f "${MISE_DATA_DIR:-${XDG_DATA_HOME:-${HOME:-}/.local/share}/mise}/shims/jq")
    file=$(cd "$scratch" && MISE_CEILING_PATHS=$scratch "$mise" exec -- jq -r "$filter" <<<"$input" 2>/dev/null)
  fi || {
    echo "structure-hook: needs jq on PATH or in mise's global config, and an event jq can read" >&2
    exit 1
  }
  file=${file%x}
  if [ -z "$file" ] || [ ! -f "$file" ]; then exit 0; fi
  printf '%s' "$file" >"$scratch/file"
  # A name may start with "-" and end in a newline, so no dirname, no basename.
  case $file in /*) ;; *) file=./$file ;; esac
  folder=${file%/*}
  folder=${folder:-/}
  name=${file##*/}
  # With no git, each "|| exit 0" below would pass the file unchecked.
  if ! command -v git >/dev/null; then
    echo 'structure-hook: needs git on PATH, not only as a mise shim' >&2
    exit 1
  fi
  # Git reads a file such as .gitignore or a link to /dev/zero whole, however large.
  ulimit -v 4194304 2>/dev/null
  # The edited file's own repo decides, whatever repo the caller's GIT_DIR names.
  # Config passed by environment stays: it may be what guards an unread repo.
  # shellcheck disable=SC2046
  unset $(git rev-parse --local-env-vars 2>/dev/null | grep -v '^GIT_CONFIG')
  top=$(git -C "$folder" rev-parse --show-toplevel 2>/dev/null && echo x) || exit 0
  top=${top%$'\n'x}
  # Look for a copy by this hook's path in its repo. Git answers for the folder a
  # symlink reaches, so also try the path from each folder above that has a .git.
  self=$(basename "$0")
  at=$(git -C "$dir" rev-parse --show-prefix 2>/dev/null)
  root=$dir
  until [ -f "$top/$at/$self" ]; do
    [ -n "$root" ] || exit 0
    if [ -e "$root/.git" ]; then at=${dir#"$root"}; fi
    root=${root%/*}
  done
  cd "$folder" || exit 0

  # Git obeys the repo it works in, and core.fsmonitor, filters, hooks, pagers and
  # lazy fetches all run commands. So work against an empty throwaway git dir: the
  # checks see the size on disk and the folder's entries, and the edited repo stays
  # as it was. The user's own config stays in force, but its fsmonitor would watch
  # a folder about to go.
  exclude=$(git rev-parse --git-path info/exclude) || exit 0
  git init -q --bare --template= "$scratch/git" >/dev/null 2>&1 || exit 0
  printf '[core]\n\tfsmonitor = false\n' >>"$scratch/git/config"
  mkdir "$scratch/git/info" "$scratch/tmp"
  if [ -f "$exclude" ]; then head -c 1048576 "$exclude" >"$scratch/git/info/exclude" 2>/dev/null; fi
  export GIT_DIR=$scratch/git GIT_WORK_TREE=$top TMPDIR=$scratch/tmp
  git add -- ":(literal)$name" 2>/dev/null || exit 0

  failed=0
  size=$("$dir/check-file-size" "./$name" 2>&1 >/dev/null) || failed=1
  fan=$("$dir/check-fan-out" "./$name" 2>&1 >/dev/null) || failed=1
  if [ "$failed" -eq 0 ]; then exit 0; fi
  if [ -n "$size" ] && [ -n "$fan" ]; then size=$size$'\n\n'; fi
  echo "$size$fan" >&2
  exit 2
}

# The check and the job that ends it each get a process group, so a kill reaches
# what they started. "sleep" must not outlive the hook or hold its stderr.
body=
watcher=
# shellcheck disable=SC2329
stop() {
  kill -KILL -- "-$body" "-$watcher" 2>/dev/null
  rm -rf "$scratch"
}
trap stop EXIT
trap 'exit 143' TERM INT HUP
set -m
check 3<&0 </dev/null &
body=$!
(
  sleep "$limit"
  kill -KILL -- "-$body"
) </dev/null >/dev/null 2>&1 &
watcher=$!
set +m
disown "$watcher"
wait "$body" 2>/dev/null
rc=$?
if [ "$rc" -gt 128 ]; then
  file=$(cat "$scratch/file" 2>/dev/null)
  echo "structure-hook: gave up on ${file:-the edited file} after ${limit} s; stdin or a file in its repo may block" >&2
  exit 1
fi
exit "$rc"
