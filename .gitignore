# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.ty_cache/

# Frontend
node_modules/
frontend/dist/

# Local env files
backend/.env
backend/.env.local

# The dev vault — notes are yours, not the repo's
vault/

# Dependency trees belonging to the dev containers, kept out of the host's.
.container/

# Brainstorms and plans, which are working notes rather than the repo's record.
# Ignored rather than merely untracked so ruff stops formatting the python in
# them and failing the pre-commit hook.
.workbench/

# Editors / OS
.DS_Store
.idea/

# Router types the TanStack plugin regenerates on every dev run.
.tanstack/
