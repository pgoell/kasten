# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.ty_cache/

# Frontend
node_modules/
frontend/dist/

# Local env files
backend/.env
backend/.env.local

# The dev vault — notes are yours, not the repo's
/vault/

# The token store, the dump receipts and the GitHub contributions cache beside it,
# which dev keeps in the working directory because `KASTEN_TOKENS_PATH` defaults
# to a relative path.
tokens.json
dump-receipts.json
github-contributions.json

# Dependency trees belonging to the dev containers, kept out of the host's.
.container/

# Brainstorms and plans, which are working notes rather than the repo's record.
# Ignored rather than merely untracked so ruff stops formatting the python in
# them and failing the pre-commit hook.
.workbench/

# Editors / OS
.DS_Store
.idea/

# Router types the TanStack plugin regenerates on every dev run.
.tanstack/

# Staged into public/ by the `foliatePdfjs` plugin in vite.config.ts, out of
# foliate's own vendored pdf.js. Generated on every dev start and every build.
frontend/public/pdfjs/
# Its copies on the way in, which only a start killed mid-copy leaves behind.
frontend/.pdfjs-*/
