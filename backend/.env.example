# Copy to backend/.env and adjust. All settings take the KASTEN_ prefix.
# Every value here is already the default, so a fresh clone runs without it.

# The dev database is kasten's own compose Postgres, published on the host at
# :5434. Dev cannot use the shared `postgres` container: that one publishes no
# host port, and the dev backend runs on the host rather than in a container.
KASTEN_DATABASE_URL=postgresql+psycopg://kasten:kasten@localhost:5434/kasten_dev

# The markdown vault. This directory is the source of truth for the notes;
# Postgres holds no index of it, only finance, RSVP places and the token
# record. Relative to the working directory, so start the app from the repo root.
KASTEN_VAULT_PATH=vault
