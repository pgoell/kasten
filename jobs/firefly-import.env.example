# The Firefly import's env file. Copy to ~/.config/kasten/firefly-import.env on
# the server, fill in, and `chmod 600` it. Never commit the filled-in copy.
# Every variable is in docs/reference/firefly-import.md.

# The backend, by its container name on the docker network `web`.
KASTEN_API=http://kasten-backend-prod:8000

# Firefly's database, by the Postgres container's name on `web`. The user and
# password are the DB_USERNAME and DB_PASSWORD the firefly container runs with.
# The import opens a read-only session (default_transaction_read_only=on)
# and only ever reads.
FIREFLY_DATABASE_URL=postgresql://USER:PASSWORD@postgres:5432/firefly

# Firefly journal ids to leave out, commas between, such as the old
# importer's doubles. The same as one --skip-journal per id.
FIREFLY_SKIP_JOURNALS=
