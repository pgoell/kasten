# The bank sync's env file. Copy to ~/.config/kasten/bank-sync.env on the
# server, fill in, and `chmod 600` it. Never commit the filled-in copy.
# Every variable is in docs/reference/bank-sync.md.

# The backend, by its container name on the docker network `web`.
KASTEN_API=http://kasten-backend-prod:8000

# The banks to pull, as the prefixes of the variables below.
BANK_SYNC_BANKS=DKB,PSD

# DKB. The login is the DKB app's Anmeldename.
DKB_BLZ=12030000
DKB_LOGIN=
DKB_PIN=
DKB_FINTS_URL=https://fints.dkb.de/fints

# PSD Bank Nürnberg. The login is the VR-NetKey or its alias.
PSD_BLZ=76090900
PSD_LOGIN=
PSD_PIN=
PSD_FINTS_URL=https://fints2.atruvia.de/cgi-bin/hbciservlet

# Where the state blobs live inside the container: the mount of ~/.config/kasten/fints.
BANK_SYNC_STATE_DIR=/state

# Each window starts this many days before the last good one ended.
BANK_SYNC_OVERLAP_DAYS=5
# How far back a first pull goes for an account with no bookings stored.
BANK_SYNC_FIRST_DAYS=90
# `check` fails when no run has succeeded for this many days.
BANK_SYNC_STALE_DAYS=7
