# The receipt job's env file. Copy to ~/.config/kasten/receipts.env on the
# server and `chmod 600` it: it holds the Claude Code token. The Gmail login
# is its own file, mounted read-only. Every variable is in
# docs/reference/receipt-jobs.md. No quotes around a value: docker's
# --env-file keeps them as part of it.

# A mail's day is the box's day, not UTC's.
TZ=Europe/Berlin

# The backend, by its container name on the docker network `web`.
KASTEN_API=http://kasten-backend-prod:8000

# The token headless Claude Code reads receipts with, on the owner's Claude
# subscription: run `claude setup-token` and paste what it prints. Each
# receipt counts against the subscription's usage limits.
# `kasten-receipts mail` alone needs none.
CLAUDE_CODE_OAUTH_TOKEN=REPLACE_ME

# Where the Gmail login sits inside the container: the mount of
# ~/.config/kasten/gmail.json, the one the order sync uses.
RECEIPTS_GMAIL_CREDENTIALS=/gmail.json

# The Gmail label whose mails carry receipts as PDF attachments; any label works.
RECEIPTS_LABEL=Receipt

# How many days of mail each run reads.
RECEIPTS_DAYS=30

# The model that reads the receipts.
RECEIPTS_MODEL=claude-sonnet-5-5
