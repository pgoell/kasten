# The order mail job's env file. Copy to ~/.config/kasten/order-sync.env on
# the server and `chmod 600` it. It holds no secret: the Gmail login is its
# own file, mounted read-only. Every variable is in docs/reference/order-sync.md.
# No quotes around a value: docker's --env-file keeps them as part of it.

# A mail's day is the box's day, not UTC's.
TZ=Europe/Berlin

# The backend, by its container name on the docker network `web`.
KASTEN_API=http://kasten-backend-prod:8000

# Where the Gmail login sits inside the container: the mount of
# ~/.config/kasten/gmail.json.
ORDER_SYNC_GMAIL_CREDENTIALS=/gmail.json

# How many days of mail each run reads.
ORDER_SYNC_DAYS=60
